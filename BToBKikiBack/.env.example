# Base de donnees PostgreSQL (Neon)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/kiki_b2b
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres

# JWT
APP_JWT_SECRET=change-me-to-a-strong-256-bit-secret-key
APP_JWT_EXPIRATION_MS=86400000

# Frontend URL (pour les liens dans les emails Brevo)
APP_FRONTEND_URL=http://localhost:4200

# Brevo Transactional Email API (recommande sur Render)
BREVO_API_KEY=
BREVO_SENDER_EMAIL=noreply@kikitraiteur.sn
BREVO_SENDER_NAME=Kiki Traiteur B2B

# Brevo SMTP (optionnel, fallback si BREVO_API_KEY vide)
SPRING_MAIL_HOST=smtp-relay.brevo.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
