# =============================================================================
# Kiki Traiteur Frontend - Exemple de Configuration des Environnements
# Copiez ce fichier vers .env pour personnaliser vos variables locales :
#   cp .env.example .env
# =============================================================================

# --- Environnement de DÉVELOPPEMENT (Local) ---
API_URL=http://localhost:8080

# --- Environnement de PRODUCTION (Render / Serveur distant) ---
PROD_API_URL=https://kiki-backend-iuyo.onrender.com

# --- Configuration Cloudinary pour l'upload d'images ---
CLOUDINARY_CLOUD_NAME=votre_cloud_name
CLOUDINARY_API_KEY=votre_api_key
CLOUDINARY_UPLOAD_PRESET=votre_upload_preset
CLOUDINARY_FOLDER=kikitraiteur
CLOUDINARY_API_URL=https://api.cloudinary.com/v1_1
